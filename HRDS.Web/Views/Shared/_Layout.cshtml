@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var isAr = currentCulture.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<style>

    .company-select-btn {
        background-color: #1e293b !important;
        color: #ffffff !important;
        border: 1px solid #334155 !important;
        border-radius: 8px;
        padding: 6px 14px;
    }

        .company-select-btn:hover, .company-select-btn:focus {
            border-color: #38bdf8 !important;
            color: #ffffff !important;
        }

</style>

<link href="~/css/dark-theme.css" rel="stylesheet" />

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isAr ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HRDS ERP - @ViewData["Title"]</title>

    <!-- Bootstrap CSS بناءً على اللغة -->
    @if (isAr)
    {
        <link href="~/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    }
    else
    {
        <link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    }

    <link href="~/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="~/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
</head>

<body>

    <div class="erp-app-layout">

        <!-- Navbar -->
        @using HRDS.Web.Resources

        <header class="erp-header d-flex justify-content-between align-items-center">
            <!-- Right/Left Side (Brand & Menu Toggle) -->
            <div class="d-flex align-items-center gap-3">
                <button id="sidebarToggle" class="toggle-btn" type="button" title="@(isAr ? "القائمة" : "Menu")">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none">
                    <span class="fw-bold text-white fs-6">HRDS <span class="text-primary">ERP</span></span>
                </a>
            </div>

            @* <!-- Search Bar -->
            <div class="erp-search-box d-none d-md-block">
                <i class="bi bi-search search-icon"></i>
                <input type="text" placeholder="@(isAr ? "بحث سريع في أجزاء النظام..." : "Quick search in system...")">
            </div> *@

            <!-- Left/Right Side (Branch, Profile, Notifications) -->
            <div class="d-flex align-items-center gap-3">
                <!-- قائمة اختيار الشركة -->
                @await Component.InvokeAsync("CompanySwitch")

                <!-- الإشعارات -->
                <button class="btn toggle-btn position-relative p-0" type="button">
                    <i class="bi bi-bell fs-6"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                </button>

                <!-- قائمة اختيار اللغة -->
                <div class="dropdown">
                    <button class="btn language-select-btn dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-globe text-info"></i>
                        <span class="d-none d-md-inline">@(isAr ? "العربية" : "English")</span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-dark @(isAr ? "dropdown-menu-end" : "dropdown-menu-start") shadow-lg border-secondary border-opacity-25">
                        <!-- الخيار الأول: العربية -->
                        <li>
                            <form action="/Language/SetLanguage" method="post" class="m-0 p-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <input type="hidden" name="culture" value="ar" />
                                <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between @(isAr ? "active" : "")">
                                    <span><i class="bi bi-check2 ms-1 me-1 @(isAr ? "" : "d-none")"></i>العربية</span>
                                    <span class="badge bg-secondary bg-opacity-25 fs-8">AR</span>
                                </button>
                            </form>
                        </li>

                        <!-- الخيار الثاني: English -->
                        <li>
                            <form action="/Language/SetLanguage" method="post" class="m-0 p-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <input type="hidden" name="culture" value="en" />
                                <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between @(!isAr ? "active" : "")">
                                    <span><i class="bi bi-check2 ms-1 me-1 @(!isAr ? "" : "d-none")"></i>English</span>
                                    <span class="badge bg-secondary bg-opacity-25 fs-8">EN</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

                <!-- البروفايل واسم المستخدم -->
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle user-profile-btn" data-bs-toggle="dropdown">
                        <span class="user-avatar-badge">AD</span>
                        <span class="user-name d-none d-sm-inline">admin</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark @(isAr ? "dropdown-menu-start" : "dropdown-menu-end") shadow-lg">
                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="bi bi-person ms-1 me-2"></i> @(isAr ? "الملف الشخصي" : "Profile")
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#">
                                <i class="bi bi-gear ms-1 me-2"></i> @(isAr ? "الإعدادات" : "Settings")
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-area="Security" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="dropdown-item text-danger border-0 bg-transparent btn-link text-start w-100">
                                    <i class="bi bi-box-arrow-right ms-1 me-2"></i> @(isAr ? "تسجيل الخروج" : "Logout")
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Main Workspace -->
        <div class="erp-main-container">
            <!-- Dynamic Sidebar ViewComponent -->
            @await Component.InvokeAsync("Sidebar")
            <!-- Main Content Area -->
            <main class="erp-content-area">
                @RenderBody()
            </main>

        </div>
    </div>

    <!-- 1. jQuery -->
    <script src="~/jquery/jquery.min.js"></script>

    <!-- 2. Bootstrap JS -->
    <script src="~/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- 3. DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script src="~/sweetalert2/sweetalert2.all.min.js"></script>

    <partial name="_SweetAlertMessages" />
    <partial name="_SweetAlertValidation" />


    <!-- 4. Section Scripts (لعملية تحميل السكريبتات الخاصة بالشاشات الفرعية) -->
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleBtn = document.getElementById('sidebarToggle');
            const sidebar = document.getElementById('sidebar');

            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    sidebar.classList.toggle('collapsed');
                });
            }
        });
    </script>

</body>
</html>