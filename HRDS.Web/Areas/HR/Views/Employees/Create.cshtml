                                                <option value="">@(isArabic ? "-- اختر نوع الاستقطاع --" : "-- Select Deduction --")</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4 text-start">
                                            <label class="form-label form-label-dark">@(isArabic ? "المبلغ" : "Amount")</label>
                                            <input name="Deductions[0].Amount" type="number" step="0.0001" class="form-control form-control-dark" placeholder="0.00" />
                                        </div>
                                        <div class="col-md-2 text-start">
                                            <label class="form-label form-label-dark">@(isArabic ? "من تاريخ" : "From Date")</label>
                                            <input name="Deductions[0].FromDate" type="date" class="form-control form-control-dark" />
                                        </div>
                                        <div class="col-md-2 text-start">
                                            <label class="form-label form-label-dark">@(isArabic ? "إلى تاريخ" : "To Date")</label>
                                            <input name="Deductions[0].ToDate" type="date" class="form-control form-control-dark" />
                                        </div>
                                        <div class="col-md-12 text-start">
                                            <input name="Deductions[0].Notes" class="form-control form-control-dark" placeholder="@(isArabic ? "ملاحظات الاستقطاع..." : "Notes...")" />
