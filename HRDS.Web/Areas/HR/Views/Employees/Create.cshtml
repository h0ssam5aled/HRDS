@model HRDS.Web.Areas.HR.ViewModels.EmployeeViewModel

@{
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = isArabic ? "إضافة موظف جديد" : "Add New Employee";
    var currentDir = isArabic ? "rtl" : "ltr";
}

<style>
    /* تنسيق الـ Tabs للثيم الداكن */
    .dark-card .nav-tabs {
        border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
    }

        .dark-card .nav-tabs .nav-link {
            background-color: transparent !important;
            border: none !important;
            color: #94a3b8 !important; /* لون رمادي فاتح للـ Tab غير النشط */
            padding: 0.75rem 1.25rem;
            font-weight: 600;
            transition: all 0.2s ease-in-out;
        }

            .dark-card .nav-tabs .nav-link:hover {
                color: #38bdf8 !important;
            }

            /* تنسيق الـ Tab النشط Active */
            .dark-card .nav-tabs .nav-link.active {
                background-color: transparent !important;
                color: #38bdf8 !important; /* لون السيان النيون */
                border: none !important;
                border-bottom: 3px solid #38bdf8 !important; /* خط سفلية مضيء */
                box-shadow: 0 4px 12px rgba(56, 189, 248, 0.15);
            }

</style>

<div class="container-fluid py-3" dir="@currentDir">
    <form asp-action="Create" class="row g-3 needs-validation" novalidate>
        @Html.AntiForgeryToken()

        <!-- Header Bar -->
        <div class="card dark-card shadow-sm mb-4">
            <div class="card-body d-flex align-items-center justify-content-between py-3">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-person-plus fs-3 text-info"></i>
                    <div class="d-flex flex-column align-items-start text-start">
                        <h4 class="mb-0 fw-bold">@(isArabic ? "إضافة موظف جديد" : "Add New Employee")</h4>
                        <p class="text-muted mb-0 small">@(isArabic ? "إدخال بيانات الموظف الاتصال والبيانات الشخصية" : "Enter employee personal and contact details")</p>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-dark-cancel px-3">
                        <i class="bi bi-arrow-right me-1"></i> @(isArabic ? "إلغاء" : "Cancel")
                    </a>
                    <button type="submit" class="btn btn-neon-save px-3">
                        <i class="bi bi-check-lg me-1"></i> @(isArabic ? "حفظ البيانات" : "Save Data")
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Card with Nav Tabs -->
        <div class="card dark-card shadow-sm">
            <ul class="nav nav-tabs card-header-tabs" id="employeeTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal" type="button" role="tab">
                        <i class="bi bi-person me-1"></i> @(isArabic ? "البيانات الأساسية والشخصية" : "Basic & Personal Info")
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact" type="button" role="tab">
                        <i class="bi bi-telephone me-1"></i> @(isArabic ? "بيانات الاتصال والعنوان" : "Contact & Address Info")
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="emergency-tab" data-bs-toggle="tab" data-bs-target="#emergency" type="button" role="tab">
                        <i class="bi bi-shield-exclamation me-1"></i> @(isArabic ? "جهة اتصال الطوارئ" : "Emergency Contact")
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="employment-tab" data-bs-toggle="tab" data-bs-target="#employment" type="button" role="tab">
                        <i class="bi bi-briefcase me-1"></i> @(isArabic ? "البيانات الوظيفية" : "Employment History")
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="position-tab" data-bs-toggle="tab" data-bs-target="#position" type="button" role="tab">
                        <i class="bi bi-diagram-3 me-1"></i> @(isArabic ? "المنصب الوظيفي" : "Employee Position")
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="qualification-tab" data-bs-toggle="tab" data-bs-target="#qualification" type="button" role="tab">
                        <i class="bi bi-mortarboard me-1"></i> @(isArabic ? "المؤهلات العلمية" : "Qualifications")
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="bank-tab" data-bs-toggle="tab" data-bs-target="#bank" type="button" role="tab">
                        <i class="bi bi-bank me-1"></i> @(isArabic ? "الحساب البنكي" : "Bank Account")
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="schedule-tab" data-bs-toggle="tab" data-bs-target="#schedule" type="button" role="tab">
                        <i class="bi bi-calendar-week me-1"></i> @(isArabic ? "مواعيد العمل والوردية" : "Work Schedule")
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="document-tab" data-bs-toggle="tab" data-bs-target="#document" type="button" role="tab">
                        <i class="bi bi-file-earmark-text me-1"></i> @(isArabic ? "المستندات والأوراق" : "Documents")
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="probation-tab" data-bs-toggle="tab" data-bs-target="#probation" type="button" role="tab">
                        <i class="bi bi-hourglass-split me-1"></i> @(isArabic ? "فترة التجربة" : "Probation Period")
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="salary-tab" data-bs-toggle="tab" data-bs-target="#salary" type="button" role="tab">
                        <i class="bi bi-cash-stack me-1"></i> @(isArabic ? "تفاصيل الراتب" : "Salary Details")
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="allowance-deduction-tab" data-bs-toggle="tab" data-bs-target="#allowance-deduction" type="button" role="tab">
                        <i class="bi bi-wallet2 me-1"></i> @(isArabic ? "البدلات والاستقطاعات" : "Allowances & Deductions")
                    </button>
                </li>
            </ul>

            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="tab-content" id="employeeTabsContent">

                    <!-- TAB 1: البيانات الأساسية والشخصية -->
                    <div class="tab-pane fade show active" id="personal" role="tabpanel">
                        <div class="row g-3">
                            <!-- Codes -->
                            <div class="col-md-6 text-start">
                                <label asp-for="EmployeeCode" class="form-label form-label-dark">@(isArabic ? "كود الموظف" : "Employee Code")</label>
                                <input asp-for="EmployeeCode" class="form-control form-control-dark font-monospace text-info fw-bold"
                                       value="@(isArabic ? "تلقائي بواسطة النظام" : "Auto-generated by system")" readonly />
                                <span class="text-light-muted small">
                                    @(isArabic ? "سيتم توليد الكود تسلسلياً تلقائياً عند الحفظ" : "Code will be generated automatically upon saving")
                                </span>
                            </div>
                            <div class="col-md-6 text-start">
                                <label asp-for="EmployeeOldCode" class="form-label form-label-dark">@(isArabic ? "الكود القديم" : "Old Code")</label>
                                <input asp-for="EmployeeOldCode" class="form-control form-control-dark" />
                            </div>

                            <!-- Arabic Name -->
                            <div class="col-md-4 text-start">
                                <label asp-for="FirstNameAr" class="form-label form-label-dark">@(isArabic ? "الاسم الأول (عربي)" : "First Name (Arabic)") <span class="text-danger">*</span></label>
                                <input asp-for="FirstNameAr" class="form-control form-control-dark" required />
                            </div>
                            <div class="col-md-4 text-start">
                                <label asp-for="MiddleNameAr" class="form-label form-label-dark">@(isArabic ? "الاسم الأوسط (عربي)" : "Middle Name (Arabic)")</label>
                                <input asp-for="MiddleNameAr" class="form-control form-control-dark" />
                            </div>
                            <div class="col-md-4 text-start">
                                <label asp-for="LastNameAr" class="form-label form-label-dark">@(isArabic ? "اسم العائلة (عربي)" : "Last Name (Arabic)") <span class="text-danger">*</span></label>
                                <input asp-for="LastNameAr" class="form-control form-control-dark" required />
                            </div>

                            <!-- English Name -->
                            <div class="col-md-4 text-start">
                                <label asp-for="FirstNameEn" class="form-label form-label-dark">@(isArabic ? "الاسم الأول (إنجليزي)" : "First Name (English)")</label>
                                <input asp-for="FirstNameEn" class="form-control form-control-dark" required />
                            </div>
                            <div class="col-md-4 text-start">
                                <label asp-for="MiddleNameEn" class="form-label form-label-dark">@(isArabic ? "الاسم الأوسط (إنجليزي)" : "Middle Name (English)")</label>
                                <input asp-for="MiddleNameEn" class="form-control form-control-dark" />
                            </div>
                            <div class="col-md-4 text-start">
                                <label asp-for="LastNameEn" class="form-label form-label-dark">@(isArabic ? "اسم العائلة (إنجليزي)" : "Last Name (English)")</label>
                                <input asp-for="LastNameEn" class="form-control form-control-dark" required />
                            </div>

                            <!-- Dropdowns (النوع / الديانة / الحالة الاجتماعية) -->
                            <div class="col-md-4 text-start">
                                <label asp-for="GenderId" class="form-label form-label-dark">@(isArabic ? "النوع" : "Gender")</label>
                                <select asp-for="GenderId" class="form-select form-select-dark" asp-items="ViewBag.Genders">
                                    <option value="">@(isArabic ? "-- اختر النوع --" : "-- Select Gender --")</option>
                                </select>
                            </div>
                            <div class="col-md-4 text-start">
                                <label asp-for="ReligionId" class="form-label form-label-dark">@(isArabic ? "الديانة" : "Religion")</label>
                                <select asp-for="ReligionId" class="form-select form-select-dark" asp-items="ViewBag.Religions">
                                    <option value="">@(isArabic ? "-- اختر الديانة --" : "-- Select Religion --")</option>
                                </select>
                            </div>
                            <div class="col-md-4 text-start">
                                <label asp-for="MaritalStatusId" class="form-label form-label-dark">@(isArabic ? "الحالة الاجتماعية" : "Marital Status")</label>
                                <select asp-for="MaritalStatusId" class="form-select form-select-dark" asp-items="ViewBag.MaritalStatuses">
                                    <option value="">@(isArabic ? "-- اختر الحالة --" : "-- Select Status --")</option>
                                </select>
                            </div>

                            <!-- Dropdowns (الجنسية / الموقف العسكري / تاريخ الميلاد) -->
                            <div class="col-md-4 text-start">
                                <label asp-for="NationalityId" class="form-label form-label-dark">@(isArabic ? "الجنسية" : "Nationality")</label>
                                <select asp-for="NationalityId" class="form-select form-select-dark" asp-items="ViewBag.Nationalities">
                                    <option value="">@(isArabic ? "-- اختر الجنسية --" : "-- Select Nationality --")</option>
                                </select>
                            </div>
                            <div class="col-md-4 text-start">
                                <label asp-for="MilitaryStatusId" class="form-label form-label-dark">@(isArabic ? "الموقف من التجنيد" : "Military Status")</label>
                                <select asp-for="MilitaryStatusId" class="form-select form-select-dark" asp-items="ViewBag.MilitaryStatuses">
                                    <option value="">@(isArabic ? "-- اختر الموقف --" : "-- Select Military Status --")</option>
                                </select>
                            </div>
                            <div class="col-md-4 text-start">
                                <label asp-for="DateOfBirth" class="form-label form-label-dark">@(isArabic ? "تاريخ الميلاد" : "Date of Birth")</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control form-control-dark" />
                            </div>

                            <!-- Documents -->
                            <div class="col-md-4 text-start">
                                <label asp-for="NationalIdNo" class="form-label form-label-dark">@(isArabic ? "الرقم القومي" : "National ID")</label>
                                <input asp-for="NationalIdNo" class="form-control form-control-dark" maxlength="14" />
                            </div>
                            <div class="col-md-4 text-start">
                                <label asp-for="PassportNumber" class="form-label form-label-dark">@(isArabic ? "رقم الجواز" : "Passport Number")</label>
                                <input asp-for="PassportNumber" class="form-control form-control-dark" />
                            </div>
                            <div class="col-md-4 text-start">
                                <label asp-for="DriverLicenseNumber" class="form-label form-label-dark">@(isArabic ? "رقم رخصة القيادة" : "Driver License Number")</label>
                                <input asp-for="DriverLicenseNumber" class="form-control form-control-dark" />
                            </div>

                            <!-- Status -->
                            <div class="col-md-12 text-start my-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" checked>
                                    <label class="form-check-label text-white ms-2" asp-for="IsActive">@(isArabic ? "نشط" : "Active")</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 2: بيانات الاتصال والعنوان (EmployeesDatum) -->
                    <div class="tab-pane fade" id="contact" role="tabpanel">
                        <div class="row g-3">
                            <!-- Location Dropdowns (الدولة - المحافظة - المدينة) -->
                            <div class="col-md-4 text-start">
                                <label asp-for="CountryId" class="form-label form-label-dark">@(isArabic ? "الدولة" : "Country")</label>
                                <select asp-for="CountryId" id="CountryId" class="form-select form-select-dark" asp-items="ViewBag.Countries">
                                    <option value="">@(isArabic ? "-- اختر الدولة --" : "-- Select Country --")</option>
                                </select>
                            </div>
                            <div class="col-md-4 text-start">
                                <label asp-for="GovernorateId" class="form-label form-label-dark">@(isArabic ? "المحافظة" : "Governorate")</label>
                                <select asp-for="GovernorateId" id="GovernorateId" class="form-select form-select-dark" asp-items="ViewBag.Governorates">
                                    <option value="">@(isArabic ? "-- اختر المحافظة --" : "-- Select Governorate --")</option>
                                </select>
                            </div>
                            <div class="col-md-4 text-start">
                                <label asp-for="CityId" class="form-label form-label-dark">@(isArabic ? "المدينة" : "City")</label>
                                <select asp-for="CityId" id="CityId" class="form-select form-select-dark" asp-items="ViewBag.Cities">
                                    <option value="">@(isArabic ? "-- اختر المدينة --" : "-- Select City --")</option>
                                </select>
                            </div>

                            <!-- Detailed Address -->
                            <div class="col-md-12 text-start">
                                <label asp-for="EmployeeAddress" class="form-label form-label-dark">@(isArabic ? "العنوان بالتفصيل" : "Address Detail")</label>
                                <input asp-for="EmployeeAddress" class="form-control form-control-dark" />
                            </div>

                            <!-- Email -->
                            <div class="col-md-12 text-start">
                                <label asp-for="Email" class="form-label form-label-dark">@(isArabic ? "البريد الإلكتروني" : "Email")</label>
                                <input asp-for="Email" type="email" class="form-control form-control-dark" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Mobile Numbers -->
                            <div class="col-md-6 text-start">
                                <label asp-for="FirstMobileNo" class="form-label form-label-dark">@(isArabic ? "الموبايل الأول" : "First Mobile No")</label>
                                <input asp-for="FirstMobileNo" class="form-control form-control-dark" />
                            </div>
                            <div class="col-md-6 text-start">
                                <label asp-for="SecondMobileNo" class="form-label form-label-dark">@(isArabic ? "الموبايل الثاني" : "Second Mobile No")</label>
                                <input asp-for="SecondMobileNo" class="form-control form-control-dark" />
                            </div>

                            <!-- Phone Numbers -->
                            <div class="col-md-6 text-start">
                                <label asp-for="FirstPhoneNo" class="form-label form-label-dark">@(isArabic ? "التليفون الأول" : "First Phone No")</label>
                                <input asp-for="FirstPhoneNo" class="form-control form-control-dark" />
                            </div>
                            <div class="col-md-6 text-start">
                                <label asp-for="SecondPhoneNo" class="form-label form-label-dark">@(isArabic ? "التليفون الثاني" : "Second Phone No")</label>
                                <input asp-for="SecondPhoneNo" class="form-control form-control-dark" />
                            </div>
                        </div>
                    </div>

                    <!-- TAB 3: جهات الاتصال للطوارئ (EmergencyContact) -->
                    <div class="tab-pane fade" id="emergency" role="tabpanel">
                        <div class="row g-3">
                            <!-- Contact Name & Relationship -->
                            <div class="col-md-6 text-start">
                                <label asp-for="ContactName" class="form-label form-label-dark">@(isArabic ? "اسم جهة الاتصال" : "Contact Name") <span class="text-danger">*</span></label>
                                <input asp-for="ContactName" class="form-control form-control-dark" placeholder="@(isArabic ? "أدخل الاسم الكامل" : "Enter full name")" />
                                <span asp-validation-for="ContactName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 text-start">
                                <label asp-for="Relationship" class="form-label form-label-dark">@(isArabic ? "صلة القرابة" : "Relationship")</label>
                                <input asp-for="Relationship" class="form-control form-control-dark" placeholder="@(isArabic ? "مثال: أب، أخت، زوجة..." : "e.g., Father, Spouse...")" />
                                <span asp-validation-for="Relationship" class="text-danger small"></span>
                            </div>

                            <!-- Mobile Numbers -->
                            <div class="col-md-6 text-start">
                                <label asp-for="EmergencyMobileNumber" class="form-label form-label-dark">@(isArabic ? "رقم الموبايل" : "Mobile Number")</label>
                                <input asp-for="EmergencyMobileNumber" class="form-control form-control-dark" />
                            </div>
                            <div class="col-md-6 text-start">
                                <label asp-for="EmergencyAlternativeMobileNo" class="form-label form-label-dark">@(isArabic ? "موبايل بديل" : "Alt Mobile Number")</label>
                                <input asp-for="EmergencyAlternativeMobileNo" class="form-control form-control-dark" />
                            </div>

                            <!-- Phone Numbers -->
                            <div class="col-md-6 text-start">
                                <label asp-for="EmergencyPhoneNumber" class="form-label form-label-dark">@(isArabic ? "رقم الهاتف (أرضي)" : "Phone Number")</label>
                                <input asp-for="EmergencyPhoneNumber" class="form-control form-control-dark" />
                            </div>
                            <div class="col-md-6 text-start">
                                <label asp-for="EmergencyAlternativePhone" class="form-label form-label-dark">@(isArabic ? "هاتف بديل" : "Alt Phone Number")</label>
                                <input asp-for="EmergencyAlternativePhone" class="form-control form-control-dark" />
                            </div>

                            <!-- Primary Contact Switch -->
                            <div class="col-md-12 text-start">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" asp-for="IsPrimaryContact" id="IsPrimaryContact">
                                    <label class="form-check-label form-label-dark ms-2" for="IsPrimaryContact">
                                        @(isArabic ? "جهة الاتصال الرئيسية" : "Is Primary Contact")
                                    </label>
                                </div>
                            </div>

                            <!-- Notes -->
                            <div class="col-md-12 text-start">
                                <label asp-for="EmergencyNotes" class="form-label form-label-dark">@(isArabic ? "ملاحظات" : "Notes")</label>
                                <textarea asp-for="EmergencyNotes" class="form-control form-control-dark" rows="3"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 4: البيانات الوظيفية (EmploymentHistory) -->
                    <div class="tab-pane fade" id="employment" role="tabpanel">
                        <div class="row g-3">
                            <!-- Hire Date & Employment Type -->
                            <div class="col-md-6 text-start">
                                <label asp-for="HireDate" class="form-label form-label-dark">@(isArabic ? "تاريخ التعيين" : "Hire Date")<span class="text-danger">*</span></label>
                                <input asp-for="HireDate" type="date" class="form-control form-control-dark" required />
                            </div>
                            <div class="col-md-6 text-start">
                                <label asp-for="EmploymentTypeId" class="form-label form-label-dark">@(isArabic ? "نوع التوظيف" : "Employment Type")<span class="text-danger">*</span></label>
                                <select asp-for="EmploymentTypeId" class="form-select form-select-dark" asp-items="ViewBag.EmploymentTypes" required>
                                    <option value="">@(isArabic ? "-- اختر نوع التوظيف --" : "-- Select Employment Type --")</option>
                                </select>
                            </div>

                            <!-- Department & Job Title -->
                            <div class="col-md-6 text-start">
                                <label asp-for="DepartmentId" class="form-label form-label-dark">@(isArabic ? "الإدارة" : "Department")<span class="text-danger">*</span></label>
                                <select asp-for="DepartmentId" class="form-select form-select-dark" asp-items="ViewBag.Departments" required>
                                    <option value="">@(isArabic ? "-- اختر الإدارة --" : "-- Select Department --")</option>
                                </select>
                            </div>
                            <div class="col-md-6 text-start">
                                <label asp-for="JobTitleId" class="form-label form-label-dark">@(isArabic ? "المسمى الوظيفي" : "Job Title")<span class="text-danger">*</span></label>
                                <select asp-for="JobTitleId" class="form-select form-select-dark" asp-items="ViewBag.JobTitles" required>
                                    <option value="">@(isArabic ? "-- اختر المسمى الوظيفي --" : "-- Select Job Title --")</option>
                                </select>
                            </div>

                            <!-- Job Level & Status -->
                            <div class="col-md-6 text-start">
                                <label asp-for="JobLevelId" class="form-label form-label-dark">@(isArabic ? "المستوى الوظيفي" : "Job Level")</label>
                                <select asp-for="JobLevelId" class="form-select form-select-dark" asp-items="ViewBag.JobLevels">
                                    <option value="">@(isArabic ? "-- اختر المستوى الوظيفي --" : "-- Select Job Level --")</option>
                                </select>
                            </div>
                            <div class="col-md-6 text-start">
                                <label asp-for="EmployeeStatusId" class="form-label form-label-dark">@(isArabic ? "حالة الموظف" : "Employee Status")<span class="text-danger">*</span></label>
