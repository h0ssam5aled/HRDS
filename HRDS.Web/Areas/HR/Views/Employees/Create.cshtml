                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (() => {
          'use strict'
          // جلب جميع النماذج التي تتطلب validation مخصص
          const forms = document.querySelectorAll('.needs-validation')

          Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
              // إذا كان هناك مدخل غير صحيح
              if (!form.checkValidity()) {
                event.preventDefault()
                event.stopPropagation()
              }
              // إضافة الكلاس لتفعيل أنماط CSS الخاصة بـ Bootstrap
              form.classList.add('was-validated')
            }, false)
          })
        })()
    </script>

    <script>
        // المتغير المتتبع لـ Indexes الخاصة بالمستندات
        let docIndex = 1;

        // دالة إضافة مستند جديد
        function addDocumentRow() {
            const container = document.getElementById('documents-container');
            const documentTypesOptions = `@Html.Raw(string.Join("", ((SelectList)ViewBag.DocumentTypes).Select(i => $"<option value='{i.Value}'>{i.Text}</option>")))`;

            const card = document.createElement('div');
            card.className = 'card bg-dark border-secondary mb-3 document-item';
            card.setAttribute('data-index', docIndex);

            card.innerHTML = `
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-secondary">#${container.children.length + 1}</span>
                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeDocumentRow(this)">
                            <i class="bi bi-trash me-1"></i> @(isArabic ? "حذف" : "Remove")
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "نوع المستند" : "Document Type")</label>
                            <select name="Documents[${docIndex}].DocumentTypeId" class="form-select form-select-dark">
                                <option value="">@(isArabic ? "-- اختر نوع المستند --" : "-- Select Document Type --")</option>
                                ${documentTypesOptions}
                            </select>
                        </div>
                        <div class="col-md-6 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "رقم المستند" : "Document Number")</label>
                            <input name="Documents[${docIndex}].DocumentNumber" class="form-control form-control-dark" placeholder="..." />
                        </div>
                        <div class="col-md-6 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "تاريخ الإصدار" : "Issue Date")</label>
                            <input name="Documents[${docIndex}].DocumentIssueDate" type="date" class="form-control form-control-dark" />
                        </div>
                        <div class="col-md-6 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "تاريخ الانتهاء" : "Expiry Date")</label>
                            <input name="Documents[${docIndex}].DocumentExpiryDate" type="date" class="form-control form-control-dark" />
                        </div>
                        <div class="col-md-6 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "ملف المستند (PDF / Image)" : "Document File")</label>
                            <input name="Documents[${docIndex}].DocumentFile" type="file" class="form-control form-control-dark" accept=".pdf,.png,.jpg,.jpeg" />
                        </div>
                        <div class="col-md-6 text-start d-flex align-items-center pt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="Documents[${docIndex}].IsDocumentMandatory" value="true" id="isMandatory_${docIndex}">
                                <input type="hidden" name="Documents[${docIndex}].IsDocumentMandatory" value="false" />
                                <label class="form-check-label form-label-dark ms-2" for="isMandatory_${docIndex}">
                                    @(isArabic ? "مستند إجباري" : "Mandatory Document")
                                </label>
                            </div>
                        </div>
                        <div class="col-md-12 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "ملاحظات" : "Notes")</label>
                            <textarea name="Documents[${docIndex}].DocumentNotes" class="form-control form-control-dark" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            `;

            container.appendChild(card);
            docIndex++;
            updateDeleteButtons();
        }

        // دالة حذف مستند
        function removeDocumentRow(button) {
            const card = button.closest('.document-item');
            card.remove();
            reindexDocuments();
            updateDeleteButtons();
        }

        // إعادة ترتيب الترقيم للمستخدم (#1, #2, ...)
        function reindexDocuments() {
            const items = document.querySelectorAll('.document-item');
            items.forEach((item, index) => {
                const badge = item.querySelector('.badge');
                if (badge) badge.innerText = `#${index + 1}`;
            });
        }

        // إخفاء زر الحذف إذا كان هناك عنصر واحد فقط
        function updateDeleteButtons() {
            const items = document.querySelectorAll('.document-item');
            items.forEach((item) => {
                const btn = item.querySelector('.remove-doc-btn');
                if (btn) {
                    btn.classList.toggle('d-none', items.length === 1);
                }
            });
        }

        $(document).ready(function () {
            // 1. ربط القوائم المنسدلة التفاعلية (الدولة -> المحافظة -> المدينة)
            $('#CountryId').change(function () {
                var countryId = $(this).val();
                var $gov = $('#GovernorateId').empty().append('<option value="">-- @(isArabic ? "اختر المحافظة" : "Select Governorate") --</option>');
                var $city = $('#CityId').empty().append('<option value="">-- @(isArabic ? "اختر المدينة" : "Select City") --</option>');

                if (countryId) {
                    $.getJSON('@Url.Action("GetGovernorates", "Employees", new { area = "HR" })', { countryId: countryId }, function (data) {
                        if (data && data.length > 0) {
                            $.each(data, function (i, item) {
                                $gov.append($('<option>', { value: item.id, text: item.name }));
                            });
                        }
                    });
                }
            });

            $('#GovernorateId').change(function () {
                var govId = $(this).val();
                var $city = $('#CityId').empty().append('<option value="">-- @(isArabic ? "اختر المدينة" : "Select City") --</option>');

                if (govId) {
                    $.getJSON('@Url.Action("GetCities", "Employees", new { area = "HR" })', { governorateId: govId }, function (data) {
                        if (data && data.length > 0) {
                            $.each(data, function (i, item) {
                                $city.append($('<option>', { value: item.id, text: item.name }));
                            });
                        }
                    });
                }
            });

            // 2. فحص أزرار الحذف عند التحميل الأول
            updateDeleteButtons();
        });

                let allowanceIndex = 1;
        let deductionIndex = 1;

        // دوال التحكم بالبدلات
        function addAllowanceRow() {
            const container = document.getElementById('allowances-container');
            const allowanceTypesOptions = `@Html.Raw(string.Join("", ((SelectList)ViewBag.AllowanceTypes).Select(i => $"<option value='{i.Value}'>{i.Text}</option>")))`;

            const card = document.createElement('div');
            card.className = 'card bg-dark border-secondary mb-3 allowance-item';
            card.innerHTML = `
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-success">#${container.children.length + 1}</span>
                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeAllowanceRow(this)">
                            <i class="bi bi-trash me-1"></i> @(isArabic ? "حذف" : "Remove")
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "نوع البدل" : "Allowance Type")</label>
                            <select name="Allowances[${allowanceIndex}].AllowanceTypeId" class="form-select form-select-dark">
                                <option value="">@(isArabic ? "-- اختر نوع البدل --" : "-- Select Allowance --")</option>
                                ${allowanceTypesOptions}
                            </select>
                        </div>
                        <div class="col-md-4 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "المبلغ" : "Amount")</label>
                            <input name="Allowances[${allowanceIndex}].Amount" type="number" step="0.0001" class="form-control form-control-dark" placeholder="0.00" />
                        </div>
                        <div class="col-md-2 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "من تاريخ" : "From Date")</label>
                            <input name="Allowances[${allowanceIndex}].FromDate" type="date" class="form-control form-control-dark" />
                        </div>
                        <div class="col-md-2 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "إلى تاريخ" : "To Date")</label>
                            <input name="Allowances[${allowanceIndex}].ToDate" type="date" class="form-control form-control-dark" />
                        </div>
                        <div class="col-md-12 text-start">
                            <input name="Allowances[${allowanceIndex}].Notes" class="form-control form-control-dark" placeholder="@(isArabic ? "ملاحظات البدل..." : "Notes...")" />
                        </div>
                    </div>
                </div>
            `;
            container.appendChild(card);
            allowanceIndex++;
            updateAllowanceDeleteButtons();
        }

        function removeAllowanceRow(btn) {
            btn.closest('.allowance-item').remove();
            reindexContainer('.allowance-item', '.bg-success');
            updateAllowanceDeleteButtons();
        }

        function updateAllowanceDeleteButtons() {
            const items = document.querySelectorAll('.allowance-item');
            items.forEach(item => {
                const btn = item.querySelector('.remove-allowance-btn');
                if (btn) btn.classList.toggle('d-none', items.length === 1);
            });
        }

        // دوال التحكم بالاستقطاعات
        function addDeductionRow() {
            const container = document.getElementById('deductions-container');
            const deductionTypesOptions = `@Html.Raw(string.Join("", ((SelectList)ViewBag.DeductionTypes).Select(i => $"<option value='{i.Value}'>{i.Text}</option>")))`;

            const card = document.createElement('div');
            card.className = 'card bg-dark border-secondary mb-3 deduction-item';
            card.innerHTML = `
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-danger">#${container.children.length + 1}</span>
                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeDeductionRow(this)">
                            <i class="bi bi-trash me-1"></i> @(isArabic ? "حذف" : "Remove")
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "نوع الاستقطاع" : "Deduction Type")</label>
                            <select name="Deductions[${deductionIndex}].DeductionTypeId" class="form-select form-select-dark">
                                <option value="">@(isArabic ? "-- اختر نوع الاستقطاع --" : "-- Select Deduction --")</option>
                                ${deductionTypesOptions}
                            </select>
                        </div>
                        <div class="col-md-4 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "المبلغ" : "Amount")</label>
                            <input name="Deductions[${deductionIndex}].Amount" type="number" step="0.0001" class="form-control form-control-dark" placeholder="0.00" />
                        </div>
                        <div class="col-md-2 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "من تاريخ" : "From Date")</label>
                            <input name="Deductions[${deductionIndex}].FromDate" type="date" class="form-control form-control-dark" />
                        </div>
                        <div class="col-md-2 text-start">
                            <label class="form-label form-label-dark">@(isArabic ? "إلى تاريخ" : "To Date")</label>
                            <input name="Deductions[${deductionIndex}].ToDate" type="date" class="form-control form-control-dark" />
                        </div>
                        <div class="col-md-12 text-start">
                            <input name="Deductions[${deductionIndex}].Notes" class="form-control form-control-dark" placeholder="@(isArabic ? "ملاحظات الاستقطاع..." : "Notes...")" />
                        </div>
                    </div>
                </div>
            `;
            container.appendChild(card);
            deductionIndex++;
            updateDeductionDeleteButtons();
        }

        function removeDeductionRow(btn) {
            btn.closest('.deduction-item').remove();
            reindexContainer('.deduction-item', '.bg-danger');
            updateDeductionDeleteButtons();
        }

        function updateDeductionDeleteButtons() {
            const items = document.querySelectorAll('.deduction-item');
            items.forEach(item => {
                const btn = item.querySelector('.remove-deduction-btn');
                if (btn) btn.classList.toggle('d-none', items.length === 1);
            });
        }

        function reindexContainer(itemSelector, badgeSelector) {
            const items = document.querySelectorAll(itemSelector);
            items.forEach((item, index) => {
                const badge = item.querySelector(badgeSelector);
                if (badge) badge.innerText = `#${index + 1}`;
            });
        }
    </script>
}